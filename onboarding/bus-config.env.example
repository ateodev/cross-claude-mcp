# cross-claude bus — connection details for this machine.
#
# Copy this file to `bus-config.env` and fill both values in yourself, in an editor.
# Don't paste the token into a chat with an assistant: anything typed there is kept
# in the conversation transcript. The setup reads this file without displaying it.
#
# The copy is TEMPORARY and must not live inside a git working tree. Once the token
# reaches the machine's MCP registration nothing reads it again, and the last step of
# setup deletes it.
#
# BUS_URL      base URL of the bus server, no trailing /mcp   e.g. https://bus.example.com:8443
# MCP_API_KEY  the bearer token for that bus
BUS_URL=
MCP_API_KEY=
