# cross-claude bus — connection details for this machine.
#
# Copy this file to `bus-config.env` next to it and fill both values in yourself,
# in an editor. Don't paste the token into a chat with an assistant: anything typed
# there is kept in the conversation transcript. The setup reads this file without
# displaying it.
#
# BUS_URL      base URL of the bus server, no trailing /mcp   e.g. https://bus.example.com:8443
# MCP_API_KEY  the bearer token for that bus
BUS_URL=
MCP_API_KEY=
